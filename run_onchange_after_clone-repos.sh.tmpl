{{- if and .personal (ne .kind "windows") -}}
#!/bin/bash
# Clone the repos of the home folder layout when missing (list from workstation tools/repo-list.sh, WSL, 2026-11-12).
# Existing folders are never touched; updates stay manual (git pull). Edit the list to add a repo, chezmoi apply reruns it.
# Not in the list: dotfiles and workstation (chezmoi source / ~/workstation), skills (run_after_claude-own-skills),
# worktrees (git worktree add), non-git folders like ~/stacks (copy them).
set -u
# accept-new: no TTY under Ansible, known_hosts is not synced; trusts the first host key seen
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
failed=""
while read -r path url branch; do
    [ -n "$path" ] || continue
    dir="$HOME/$path"
    [ -e "$dir" ] && continue
    mkdir -p "$(dirname "$dir")"
    if git clone -q "$url" "$dir"; then
        [ "${branch:-main}" = main ] || git -C "$dir" switch -q "$branch" || failed="$failed $path(branch $branch)"
    else
        failed="$failed $path"
    fi
done <<'EOF'
