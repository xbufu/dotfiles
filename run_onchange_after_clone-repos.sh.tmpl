code/forks/ECC https://github.com/affaan-m/ECC.git
code/forks/unslop https://github.com/heydamir/unslop
code/infra/ansible ssh://git@git.bufu-sec.me/bufu/ansible.git
code/infra/ansible-roles/ansible-role-ad_asreproasting ssh://git@git.bufu-sec.me:2222/bufu/ansible-role-ad_asreproasting.git
code/infra/ansible-roles/ansible-role-ad_bdc ssh://git@git.bufu-sec.me:2222/bufu/ansible-role-ad_bdc.git
