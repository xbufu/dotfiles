# Python
export PATH=$PATH:$HOME/.local/bin

# pipx completions (bash and zsh)
# cached: generating it starts Python (~0.1 s). Rebuilt when pipx is reinstalled or updated:
# an install changes the file's ctime, unlike its mtime, which package managers keep from the build.
if command -v register-python-argcomplete >/dev/null && command -v pipx >/dev/null; then
    if [ ! -s ~/.cache/pipx-completion.sh ] || [ -n "$(find -L "$(command -v pipx)" -cnewer ~/.cache/pipx-completion.sh)" ]; then
        mkdir -p ~/.cache && register-python-argcomplete pipx > ~/.cache/pipx-completion.sh
    fi
    . ~/.cache/pipx-completion.sh
fi

# Android SDK (role android in workstation): Expo/Gradle need ANDROID_HOME, React Native 0.88 needs JDK 17
if [ -d "$HOME/Android/Sdk" ]; then
    export ANDROID_HOME="$HOME/Android/Sdk"
    export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
fi
[ -d /usr/lib/jvm/java-17-openjdk ] && export JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# Go
export GOPATH=$HOME/.go
export PATH=$PATH:$GOPATH/bin
export PATH=$PATH:/usr/local/go/bin

# Node: fnm where installed (fast, reads .nvmrc), otherwise nvm. nvm.sh adds ~1 s to every shell start.
if command -v fnm >/dev/null; then
    eval "$(fnm env --use-on-cd --log-level quiet --shell "$([ -n "$ZSH_VERSION" ] && echo zsh || echo bash)")"
else
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm completion (bash and zsh)
    # Arch/CachyOS: nvm from pacman lives in /usr/share/nvm; node versions still go to $NVM_DIR
    [ ! -s "$NVM_DIR/nvm.sh" ] && [ -s /usr/share/nvm/nvm.sh ] && \. /usr/share/nvm/nvm.sh && \. /usr/share/nvm/bash_completion
fi
