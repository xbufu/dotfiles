{{- /* Kali default zshrc (kali-defaults etc/skel/.zshrc) plus aliases and dev paths. */ -}}
{{ template "kali-zshrc" . }}
# --- Personal additions ---

# Aliases, shared with bash through ~/.bash_aliases
if [ -f ~/.zsh_aliases ]; then
    . ~/.zsh_aliases
fi

# bash-style completions (pipx via argcomplete), as `pipx completions` asks
autoload -U bashcompinit
bashcompinit

{{ template "dev-paths" . }}
