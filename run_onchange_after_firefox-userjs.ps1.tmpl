{{- if eq .kind "windows" -}}
# Copy the shared Firefox user.js into every profile listed in profiles.ini.
# Reruns when the prefs change: {{ includeTemplate "firefox-user.js" . | sha256sum }}
$ErrorActionPreference = 'Stop'
$base = Join-Path $env:APPDATA 'Mozilla\Firefox'
$ini  = Join-Path $base 'profiles.ini'
if (-not (Test-Path -LiteralPath $ini)) {
    Write-Warning 'firefox-userjs: no Firefox profile found, skipped (start Firefox once, then chezmoi apply)'
    exit 0
}
$userJs = @'
{{ includeTemplate "firefox-user.js" . }}
'@
foreach ($line in Get-Content -LiteralPath $ini) {
    if ($line -notmatch '^Path=(.+)$') { continue }
    $path = $Matches[1] -replace '/', '\'
    $dir  = if ([IO.Path]::IsPathRooted($path)) { $path } else { Join-Path $base $path }
    if (-not (Test-Path -LiteralPath $dir)) { continue }
    [IO.File]::WriteAllText((Join-Path $dir 'user.js'), $userJs, (New-Object Text.UTF8Encoding $false))
    Write-Output "firefox-userjs: $dir\user.js"
}
{{- end }}
