#!/usr/bin/env python3
"""Play a sound for Brave's desktop notifications.

Chromium-based browsers send notifications without a sound and Plasma only
plays sounds for apps that register their own events. This listens to the
session bus as a monitor and plays the theme's message-new-instant sound for
each Notify call from Brave, unless do-not-disturb is on or the notification
asks for no sound. pw-play uses the default output device and the
Notification media role, so the system "Notification sounds" volume applies.
Runs as the user service brave-notify-sound.service.
"""
import os
import signal
import subprocess
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

MATCH = "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"
SOUND = "message-new-instant.oga"
THEMES = ("ocean", "freedesktop")
MIN_GAP = 1.0  # seconds; a burst of notifications plays one sound

last_played = 0.0


def sound_file():
    for theme in THEMES:
        path = f"/usr/share/sounds/{theme}/stereo/{SOUND}"
        if os.path.exists(path):
            return path
    return None


def notify_calls():
    """Yield (app_name, hints) for each Notify call, parsed from dbus-monitor output.

    Notify(app_name, replaces_id, icon, summary, body, actions, hints, timeout): the
    first top-level string is app_name, string/variant pairs inside the arrays are
    hints, and the closing int32 timeout ends the call.
    """
    proc = subprocess.Popen(["dbus-monitor", "--session", MATCH], stdout=subprocess.PIPE, text=True)
    in_call, app, hints, key = False, None, {}, None
    for line in proc.stdout:
        if line.startswith("method call ") and "member=Notify" in line:
            in_call, app, hints, key = True, None, {}, None
            continue
        if not in_call:
            continue
        text = line.strip()
        if line.startswith("   string ") and app is None:
            app = text[len('string "'):-1]
        elif line.startswith("   int32 "):
            in_call = False
            yield app or "", hints
        elif text.startswith('string "') and key is None and line.startswith("         "):
            key = text[len('string "'):-1]
        elif text.startswith("variant") and key is not None:
            hints[key] = text.split(None, 2)[-1].strip('"')
            key = None
    raise SystemExit("dbus-monitor exited")


def from_brave(app, hints):
    if not (hints.get("desktop-entry", "").startswith("brave-browser") or app.startswith("Brave")):
        return False
    return hints.get("suppress-sound") != "true"


def do_not_disturb(bus):
    try:
        reply = bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                              "org.freedesktop.DBus.Properties", "Get",
                              GLib.Variant("(ss)", ("org.freedesktop.Notifications", "Inhibited")),
                              GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1000, None)
        return bool(reply.unpack()[0])
    except GLib.Error:
        return False  # no notification server answer: better a sound than silence


def play(bus, path):
    global last_played
    now = time.monotonic()
    if now - last_played < MIN_GAP or do_not_disturb(bus):
        return
    last_played = now
    subprocess.Popen(["pw-play", "--media-role=Notification", path],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    path = sound_file()
    if path is None:
        raise SystemExit(f"no {SOUND} in {THEMES}")
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)  # finished pw-play processes are reaped, not left as zombies
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    for app, hints in notify_calls():
        if from_brave(app, hints):
            play(bus, path)


if __name__ == "__main__":
    main()
